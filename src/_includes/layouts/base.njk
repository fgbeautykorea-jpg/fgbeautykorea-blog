{#- Shared page shell. Pages set: title, description, pageKind (home/blog/category/tag/author/about/page), robots. -#}
{%- set o = site.publisher -%}
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{#- title · description · robots · canonical · OG · 네이버/구글 인증 · JSON-LD — eleventy.config.js › seoHead #}
{{ "" | seoHead | safe }}
<link rel="icon" href="{{ site.favicon }}">
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
{#- English display (thin, like the logo) + mono for lab-note labels #}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@300;400&family=IBM+Plex+Mono:wght@400;500&display=swap">
{#- dynamic subset: only the Korean glyphs a page uses are downloaded (faster LCP) #}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
<link rel="stylesheet" href="/styles.css">
</head>
<body>
<a class="skip" href="#main">본문 바로가기</a>
<header class="site-header">
  <div class="wrap site-header__inner">
    <a href="/" class="brand" aria-label="{{ site.name }} 홈"><img src="{{ site.logo }}" alt="FG BEAUTY KOREA" height="48" loading="eager" fetchpriority="high" sizes="120px"></a>
    <nav class="site-nav" aria-label="주요 메뉴">
      {%- for c in categories.items %}
      <a href="/blog/{{ c.id }}/"{% if (cat and cat.id == c.id) or category == c.id %} aria-current="page"{% endif %}>{{ c.name }}</a>
      {%- endfor %}
      {%- for n in site.nav %}
      <a href="{{ n.link }}"{% if page.url == n.link %} aria-current="page"{% endif %}>{{ n.label }}</a>
      {%- endfor %}
    </nav>
  </div>
</header>

<main id="main">
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <div class="site-footer__about">
      <p class="site-footer__name">{{ site.name }}</p>
      <p>{{ site.tagline }}</p>
      {%- if site.footer_note %}<p class="muted">{{ site.footer_note }}</p>{% endif %}
    </div>
    <div class="site-footer__cols">
      <div>
        <p class="site-footer__h">카테고리</p>
        {%- for c in categories.items %}<a href="/blog/{{ c.id }}/">{{ c.name }}</a>{% endfor %}
      </div>
      <div>
        <p class="site-footer__h">블로그</p>
        <a href="/blog/">전체 글</a><a href="/about/">소개</a><a href="/feed.xml">RSS 구독</a>
      </div>
    </div>
    {#- 운영 주체 — 구조화 데이터(Organization)와 같은 값. 관리자 › 사이트 설정 한 곳에서만 관리(엔티티 일관성) #}
    <p class="site-footer__legal muted">
      {%- if o.legal_name %}<span>{{ o.legal_name }}</span>{% endif %}
      {%- if o.ceo %}<span>대표 {{ o.ceo }}</span>{% endif %}
      {%- if o.bizno %}<span>사업자등록번호 {{ o.bizno }}</span>{% endif %}
      {%- if o.address %}<span>{{ o.address }}</span>{% endif %}
      {%- if o.email %}<span>{{ o.email }}</span>{% endif %}
    </p>
  </div>
</footer>
</body>
</html>
