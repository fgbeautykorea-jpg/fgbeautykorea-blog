{#- One post card (category tabs, lists). Image on top, bold title, grey summary, "자세히 보기 →". Needs `post`. -#}
{%- set pc = categories | findById(post.data.category) -%}
<article class="card">
  <a href="{{ post.url }}" class="card__link">
    <div class="card__thumb">
      {%- set th = post | thumbOf %}<img src="{{ th.src }}" alt="{{ post.data.thumb_alt or post.data.title }}"{% if th.generated %} eleventy:ignore width="1200" height="630"{% endif %} loading="lazy" decoding="async" sizes="(max-width: 768px) 100vw, 380px">
    </div>
    <div class="card__body">
      <p class="card__label"><span>{{ post.page.fileSlug | labNo }}</span>{% if pc %}<span>{{ pc.name }}</span>{% endif %}</p>
      <h3 class="card__title">{{ post.data.title }}</h3>
      {%- if post.data.excerpt %}<p class="card__excerpt">{{ post.data.excerpt }}</p>{% endif %}
      <span class="card__more">자세히 보기 <span aria-hidden="true">→</span></span>
    </div>
  </a>
</article>
